# Biến cấu hình cho e2e — copy sang e2e/.env rồi điền. KHÔNG commit e2e/.env.
# e2e.config.yaml là template đọc các ${VAR} dưới đây, nên khi chuyển project
# chỉ cần sửa file này.

# ---------- Requirement / Jira ----------
JIRA_PROJECT_KEY=BR

# Repo của app (đường dẫn tương đối từ e2e/) để đọc git diff theo branch.
# Không có repo nào thì để trống.
DIFF_REPOS=../b2bridge-api, ../b2bridge-cms

BASE_BRANCH=master

# ---------- Store & app ----------
# Phần trước .myshopify.com
STORE=my-store

# Handle của app trong Shopify Admin
APP_HANDLE=b2bridge-app

# Host domain của app — khớp src của iframe trong Admin
APP_DOMAIN=app.example.com

API_BASE_URL=https://app-api.example.com

# ---------- Secret cho API (ký session-JWT) ----------
# Thứ tự resolve: process.env → e2e/.env → file trỏ bởi API_ENV_FILE.
#
# Cách A — trỏ tới .env của app, giữ secret ở đó:
API_ENV_FILE=../b2bridge-api/.env
#
# Cách B — tự chứa: bỏ trống API_ENV_FILE ở trên rồi điền 2 dòng dưới
# (hoặc truyền qua process.env khi chạy CI):
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET_KEY=
